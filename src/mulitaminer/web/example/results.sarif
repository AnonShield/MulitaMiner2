{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "MulitaMiner",
          "version": "2.0.0a1",
          "informationUri": "https://github.com/INARI18/MulitaMiner2",
          "rules": [
            {
              "id": "OPENVAS-SMTP-too-long-line",
              "name": "SMTP too long line",
              "shortDescription": {
                "text": "SMTP too long line"
              },
              "help": {
                "text": "Solution type: VendorFix\nContact the vendor of the antivirus scanner to get an update."
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "OPENVAS-OpenVAS-Greenbone-Vulnerability-Manager-Default-Credentials",
              "name": "OpenVAS / Greenbone Vulnerability Manager Default Credentials",
              "shortDescription": {
                "text": "OpenVAS / Greenbone Vulnerability Manager Default Credentials"
              },
              "help": {
                "text": "Solution type: Workaround\nChange the password of the mentioned account(s)."
              },
              "properties": {
                "security-severity": "10.0",
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "OPENVAS-SSL-TLS-Certificate-Expired",
              "name": "SSL/TLS: Certificate Expired",
              "shortDescription": {
                "text": "SSL/TLS: Certificate Expired"
              },
              "help": {
                "text": "Solution type: Mitigation\nReplace the SSL/TLS certificate by a new one."
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "OPENVAS-Check-if-Mailserver-answer-to-VRFY-and-EXPN-requests",
              "name": "Check if Mailserver answer to VRFY and EXPN requests",
              "shortDescription": {
                "text": "Check if Mailserver answer to VRFY and EXPN requests"
              },
              "help": {
                "text": "Solution type: Workaround\nDisable VRFY and/or EXPN on your Mailserver.\nFor postfix add 'disable_vrfy_command=yes' in 'main.cf'.\nFor Sendmail add the option 'O PrivacyOptions=goaway'.\nIt is suggested that, if you really want to publish this type of information, you use a mechanism that legitimate users actually know about, such as Finger or HTTP."
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "OPENVAS-CGI-Scanning-Consolidation",
              "name": "CGI Scanning Consolidation",
              "shortDescription": {
                "text": "CGI Scanning Consolidation"
              }
            },
            {
              "id": "OPENVAS-Greenbone-Security-Assistant-GSA-Detection",
              "name": "Greenbone Security Assistant (GSA) Detection",
              "shortDescription": {
                "text": "Greenbone Security Assistant (GSA) Detection"
              }
            },
            {
              "id": "OPENVAS-HTTP-Security-Headers-Detection",
              "name": "HTTP Security Headers Detection",
              "shortDescription": {
                "text": "HTTP Security Headers Detection"
              }
            },
            {
              "id": "OPENVAS-Services",
              "name": "Services",
              "shortDescription": {
                "text": "Services"
              }
            },
            {
              "id": "OPENVAS-SSL-TLS-Collect-and-Report-Certificate-Details",
              "name": "SSL/TLS: Collect and Report Certificate Details",
              "shortDescription": {
                "text": "SSL/TLS: Collect and Report Certificate Details"
              }
            },
            {
              "id": "OPENVAS-SSL-TLS-HTTP-Public-Key-Pinning-HPKP-Missing",
              "name": "SSL/TLS: HTTP Public Key Pinning (HPKP) Missing",
              "shortDescription": {
                "text": "SSL/TLS: HTTP Public Key Pinning (HPKP) Missing"
              },
              "help": {
                "text": "Solution type: Workaround\nEnable HPKP or add / configure the required directives correctly following the guides linked in the references."
              }
            },
            {
              "id": "OPENVAS-SSL-TLS-HTTP-Strict-Transport-Security-HSTS-Missing",
              "name": "SSL/TLS: HTTP Strict Transport Security (HSTS) Missing",
              "shortDescription": {
                "text": "SSL/TLS: HTTP Strict Transport Security (HSTS) Missing"
              },
              "help": {
                "text": "Solution type: Workaround\nEnable HSTS or add / configure the required directives correctly following the guides linked in the references."
              }
            },
            {
              "id": "OPENVAS-SSL-TLS-Perfect-Forward-Secrecy-Cipher-Suites-Missing",
              "name": "SSL/TLS: Perfect Forward Secrecy Cipher Suites Missing",
              "shortDescription": {
                "text": "SSL/TLS: Perfect Forward Secrecy Cipher Suites Missing"
              }
            },
            {
              "id": "OPENVAS-SSL-TLS-Report-Medium-Cipher-Suites",
              "name": "SSL/TLS: Report Medium Cipher Suites",
              "shortDescription": {
                "text": "SSL/TLS: Report Medium Cipher Suites"
              }
            },
            {
              "id": "OPENVAS-SSL-TLS-Report-Non-Weak-Cipher-Suites",
              "name": "SSL/TLS: Report Non Weak Cipher Suites",
              "shortDescription": {
                "text": "SSL/TLS: Report Non Weak Cipher Suites"
              }
            },
            {
              "id": "OPENVAS-SSL-TLS-Report-Supported-Cipher-Suites",
              "name": "SSL/TLS: Report Supported Cipher Suites",
              "shortDescription": {
                "text": "SSL/TLS: Report Supported Cipher Suites"
              }
            },
            {
              "id": "OPENVAS-wapiti-NASL-wrapper",
              "name": "wapiti (NASL wrapper)",
              "shortDescription": {
                "text": "wapiti (NASL wrapper)"
              }
            },
            {
              "id": "OPENVAS-Postfix-SMTP-Server-Detection",
              "name": "Postfix SMTP Server Detection",
              "shortDescription": {
                "text": "Postfix SMTP Server Detection"
              }
            },
            {
              "id": "OPENVAS-SMTP-antivirus-scanner-DoS",
              "name": "SMTP antivirus scanner DoS",
              "shortDescription": {
                "text": "SMTP antivirus scanner DoS"
              },
              "help": {
                "text": "Solution type: Mitigation\nReconfigure your antivirus / upgrade it."
              },
              "properties": {
                "security-severity": "7.2",
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "OPENVAS-SMTP-Missing-Support-For-STARTTLS",
              "name": "SMTP Missing Support For STARTTLS",
              "shortDescription": {
                "text": "SMTP Missing Support For STARTTLS"
              }
            },
            {
              "id": "OPENVAS-SMTP-Server-type-and-version",
              "name": "SMTP Server type and version",
              "shortDescription": {
                "text": "SMTP Server type and version"
              }
            },
            {
              "id": "OPENVAS-OpenVAS-Greenbone-Vulnerability-Manager-Detection",
              "name": "OpenVAS / Greenbone Vulnerability Manager Detection",
              "shortDescription": {
                "text": "OpenVAS / Greenbone Vulnerability Manager Detection"
              }
            },
            {
              "id": "OPENVAS-Service-Detection-with-xml-Request",
              "name": "Service Detection with '<xml/>' Request",
              "shortDescription": {
                "text": "Service Detection with '<xml/>' Request"
              }
            },
            {
              "id": "OPENVAS-CPE-Inventory",
              "name": "CPE Inventory",
              "shortDescription": {
                "text": "CPE Inventory"
              }
            },
            {
              "id": "OPENVAS-OS-Detection-Consolidation-and-Reporting",
              "name": "OS Detection Consolidation and Reporting",
              "shortDescription": {
                "text": "OS Detection Consolidation and Reporting"
              }
            },
            {
              "id": "OPENVAS-Traceroute",
              "name": "Traceroute",
              "shortDescription": {
                "text": "Traceroute"
              },
              "help": {
                "text": "Block unwanted packets from escaping your network."
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "mulitaminer/openvas/"
      },
      "results": [
        {
          "ruleId": "OPENVAS-SMTP-too-long-line",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Some antivirus scanners dies when they process an email with a too long string without line breaks.\nSuch a message was sent. If there is an antivirus on your MTA, it might have crashed. Please check its status right now, as it is not possible to do it remotely."
          },
          "properties": {
            "severity": "HIGH",
            "cvss": 7.5,
            "source": "OPENVAS",
            "port": 25,
            "protocol": "tcp"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "127.0.0.1"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "127.0.0.1:25",
                  "kind": "resource"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "OPENVAS-OpenVAS-Greenbone-Vulnerability-Manager-Default-Credentials",
          "ruleIndex": 1,
