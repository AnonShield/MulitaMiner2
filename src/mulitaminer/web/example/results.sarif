        {
          "ruleId": "OPENVAS-wapiti-NASL-wrapper",
          "ruleIndex": 15,
          "level": "note",
          "message": {
            "text": "This plugin uses wapiti to find web security issues.\nMake sure to have wapiti 2.x as wapiti 1.x is not supported.\nSee the preferences section for wapiti options.\nNote that the scanner is using limited set of wapiti options. Therefore, for more complete web assessment, you should use standalone wapiti tool for deeper/customized checks.\nNote: The plugin needs the 'wapiti' binary found within the PATH of the user running the scanner and needs to be executable for this user. The existence of this binary is checked and reported separately within 'Availability of scanner helper tools' (OID: 1.3.6.1.4.1.25623.1.0.810000)."
          },
          "properties": {
            "severity": "LOG",
            "cvss": 0.0,
            "source": "OPENVAS",
            "port": 443,
            "protocol": "tcp"
          },
          "locations": [
