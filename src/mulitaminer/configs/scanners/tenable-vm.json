{
  "name": "tenable-vm",
  "source": "TENABLEVM",
  "fields": {
    "cvss": "list",
    "detection_result": "list",
    "plugin": "int",
    "plugin_details": "PluginDetails"
  },
  "max_vulns_per_chunk": 3,
  "marker_pattern": "^\\s*\\d{3,6}\\s+\\S.*?\\s+(Critical|High|Medium|Low|Info)\\s*$",
  "marker_join": {
    "start": "^\\s*\\d{3,6}\\s+\\S",
    "until": "\\b(Critical|High|Medium|Low|Info)\\s*$",
    "max_lines": 3
  },
  "context": {
    "host_anchor": "^Asset ID:",
    "host_line": "^((?:\\d{1,3}\\.){3}\\d{1,3})\\s*$"
  },
  "evaluation": {
    "field_metrics": { "cvss": "set_f1" },
    "key_parts": ["host", "plugin"]
  }
}
